<Window x:Class="ClicklessMouse.WindowAbout"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="730" d:DesignHeight="350"
        Title="About" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" CanResize="False" CanMinimize="False">
	<Window.Styles>
		<Style Selector="StackPanel > Label">
			<Setter Property="Margin" Value="0,10,0,0" />
			</Style>
			<Style Selector="StackPanel > Button">
				<Setter Property="Margin" Value="3,10,0,0" />
		</Style>
		<Style Selector="StackPanel > HyperlinkButton">
			<Setter Property="Padding" Value="3,0,3,3" />
			<Setter Property="Margin" Value="0,10,0,0" />
		</Style>
		<Style Selector="StackPanel">
			<Setter Property="Margin" Value="12,15,15,15" />
		</Style>
		</Window.Styles>
	<StackPanel>
		<Label x:Name="Lprogram_name" Content="Program name"
		       FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
		<Label x:Name="Llatest_version" Content="Latest version:"
		       FontSize="14"/>
		<Label x:Name="Linstalled_version" Content="Installed version:"
		       FontSize="14"/>
		<HyperlinkButton VerticalAlignment="Top" FontSize="14" x:Name="HBhomepage"></HyperlinkButton>
		<Label x:Name="Lcopyright" Content="..." FontSize="14"/>
		<Button x:Name="Bchangelog" Content="Changelog"
		        Width="161" Height="40" FontSize="14" Click="Bchangelog_Click" HorizontalAlignment="Left">
		</Button>
		<Button x:Name="Beula" Content="EULA"
		        Width="161" Height="40" FontSize="14" Click="Beula_Click" HorizontalAlignment="Left">
			</Button>
	</StackPanel>
</Window>
