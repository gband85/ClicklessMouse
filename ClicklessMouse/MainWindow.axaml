<Window x:Name="WindowMain" x:Class="ClicklessMouse.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClicklessMouse"
        xmlns:p="clr-namespace:ClicklessMouse.Properties"
        x:DataType="local:MainWindow"
        Title="Clickless Mouse" SizeToContent="WidthAndHeight"
        d:DesignHeight="462" d:DesignWidth="632" CanMaximize="False" CanMinimize="True" CanResize="False"
        WindowStartupLocation="CenterScreen" mc:Ignorable="d" Loaded="WindowMain_Loaded" 
        Closing="WindowMain_Closing">
    <Window.Styles>
        <Style Selector="Label, TextBlock, TextBox">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Width" Value="33"></Setter>
        </Style>
        <Style Selector="GroupBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="AccessText">
            <Setter Property="TextWrapping" Value="Wrap"></Setter>
        </Style>
    </Window.Styles>
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Menu x:Name="Mmain" Height="28" VerticalAlignment="Center" DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="White">
                <MenuItem x:Name="MIfile" Header="{Binding L10NResourceMgr[MIfile],Mode=OneWay}">
                    <MenuItem x:Name="MIexit" Click="MIexit_Click"
                              Header="{Binding L10NResourceMgr[MIexit],Mode=OneWay}" />
                </MenuItem>
                <MenuItem x:Name="MIrestore" Header="{Binding L10NResourceMgr[MIrestore],Mode=OneWay}">
                    <MenuItem x:Name="MIdefault_colors" Click="MIdefault_colors_Click"
                              Header="{Binding L10NResourceMgr[MIdefault_colors],Mode=OneWay}" />
                    <MenuItem x:Name="MIdefault_settings" Click="MIdefault_settings_Click"
                              Header="{Binding L10NResourceMgr[MIdefault_settings],Mode=OneWay}" />
                </MenuItem>
                <MenuItem x:Name="MIlanguage" Header="{Binding L10NResourceMgr[MIlanguage],Mode=OneWay}">
                    <MenuItem x:Name="MIenglish" ToggleType="CheckBox" Click="MIenglish_Click"
                              Header="{Binding L10NResourceMgr[MIenglish],Mode=OneWay}" />
                    <MenuItem x:Name="MIpolish" ToggleType="CheckBox" Click="MIpolish_Click"
                              Header="{Binding L10NResourceMgr[MIpolish],Mode=OneWay}" />
                </MenuItem>
                <MenuItem x:Name="MIhelp" Header="{Binding L10NResourceMgr[MIhelp],Mode=OneWay}">
                    <MenuItem x:Name="MImanual" Click="MImanual_Click"
                              Header="{Binding L10NResourceMgr[MImanual],Mode=OneWay}" />
                    <MenuItem x:Name="MIabout" Click="MIabout_Click"
                              Header="{Binding L10NResourceMgr[MIabout],Mode=OneWay}" />
                </MenuItem>
            </Menu>
        </DockPanel>
        <Grid Grid.Row="1" ColumnSpacing="32" RowSpacing="32" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox x:Name="GBmain_settings" Grid.Row="0" Grid.Column="0"
                           Header="{Binding L10NResourceMgr[GBmain_settings],Mode=OneWay}"
                           RenderOptions.EdgeMode="Antialias">
                <StackPanel Spacing="20" Orientation="Vertical">
                    <Grid Grid.Row="0" RowSpacing="15" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CHBLMB" Grid.Row="0" Grid.Column="0" IsCheckedChanged="CHBLMB_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBLMB],Mode=OneWay}"
                                  />
                        <CheckBox x:Name="CHBRMB" Grid.Row="1" Grid.Column="0" IsCheckedChanged="CHBRMB_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBRMB],Mode=OneWay}"  />
                        <CheckBox x:Name="CHBdoubleLMB" Grid.Row="2" Grid.Column="0"
                                  IsCheckedChanged="CHBdoubleLMB_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBdoubleLMB],Mode=OneWay}"
                                  />
                        <CheckBox x:Name="CHBholdLMB" Grid.Row="0" Grid.Column="1" IsCheckedChanged="CHBholdLMB_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBholdLMB],Mode=OneWay}"
                                  />
                        <CheckBox x:Name="CHBholdRMB" Grid.Row="1" Grid.Column="1" IsCheckedChanged="CHBholdRMB_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBholdRMB],Mode=OneWay}" />
                        <CheckBox x:Name="CHBscreen_panning" Grid.Row="2" Grid.Column="1" IsCheckedChanged="CHBscreen_panning_CheckedChanged"
                                  Content="{Binding L10NResourceMgr[CHBscreen_panning],Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1" RowSpacing="15" ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label x:Name="Lcursor_idle_before_squares_appear" Grid.Row="0" Grid.Column="0" Width="220">
                            <AccessText
                                Text="{Binding L10NResourceMgr[Lcursor_idle_before_squares_appear],Mode=OneWay}"/>
                        </Label>
                        <TextBox x:Name="TBcursor_idle_before_squares_appear" Grid.Row="0" Grid.Column="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 TextChanged="TBcursor_idle_before_squares_appear_TextChanged" TextWrapping="Wrap"/>
                        <Label x:Name="Ltime_to_start_mouse" Grid.Row="1" Grid.Column="0" Width="220">
                            <AccessText Text="{Binding L10NResourceMgr[Ltime_to_start_mouse],Mode=OneWay}"/>
                        </Label>
                        <TextBox x:Name="TBtime_to_start_mouse" Grid.Row="1" Grid.Column="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 TextChanged="TBtime_to_start_mouse_TextChanged" TextWrapping="Wrap" />
                        <Label x:Name="Lcursor_time_in_square" Grid.Row="2" Grid.Column="0" Width="220">
                            <AccessText
                                Text="{Binding L10NResourceMgr[Lcursor_time_in_square],Mode=OneWay}"/>
                        </Label>
                        <TextBox x:Name="TBcursor_time_in_square" Grid.Row="2" Grid.Column="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 TextChanged="TBcursor_time_in_square_TextChanged" TextWrapping="Wrap"
                                  />
                    </Grid>
</StackPanel>
        </GroupBox>
        <GroupBox x:Name="GBother_settings" Grid.Row="1"
                       Header="{Binding L10NResourceMgr[GBother_settings],Mode=OneWay}"
                       RenderOptions.EdgeMode="Antialias">
            <StackPanel>
                <CheckBox x:Name="CHBrun_at_startup" IsCheckedChanged="CHBrun_at_startup_CheckedChanged"
                          Content="{Binding L10NResourceMgr[CHBrun_at_startup],Mode=OneWay}" />
                <CheckBox x:Name="CHBstart_minimized" IsCheckedChanged="CHBstart_minimized_CheckedChanged"
                          Content="{Binding L10NResourceMgr[CHBstart_minimized],Mode=OneWay}"
                          />
                <CheckBox x:Name="CHBminimize_to_tray" IsCheckedChanged="CHBminimize_to_tray_CheckedChanged"
                          Content="{Binding L10NResourceMgr[CHBminimize_to_tray],Mode=OneWay}"
                          />
                <CheckBox x:Name="CHBcheck_for_updates" IsCheckedChanged="CHBcheck_for_updates_CheckedChanged"
                          Content="{Binding L10NResourceMgr[CHBcheck_for_updates],Mode=OneWay}" />
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="GBsquare_settings" Grid.Row="0" Grid.Column="1"
                       Header="{Binding L10NResourceMgr[GBsquare_settings],Mode=OneWay}"
                       RenderOptions.EdgeMode="Antialias">
            <Grid RowSpacing="30.70" ColumnSpacing="72">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label x:Name="Lsquare_size" Grid.Row="0" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lsquare_size],Mode=OneWay}" />
                <Label x:Name="Lsquare_border" Grid.Row="1" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lsquare_border],Mode=OneWay}" />
                <Label x:Name="Lsquare_color1" Grid.Row="2" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lsquare_color1],Mode=OneWay}" />
                <Label x:Name="Lsquare_color2" Grid.Row="3" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lsquare_color2],Mode=OneWay}" />
                <Label x:Name="Lmin_square_size" Grid.Row="4" Grid.Column="0"
                       
                       Content="{Binding L10NResourceMgr[Lmin_square_size],Mode=OneWay}" />
                <TextBox x:Name="TBsquare_size" Grid.Row="0" Grid.Column="1" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         TextChanged="TBsquare_size_TextChanged" TextWrapping="Wrap" />
                <TextBox x:Name="TBsquare_border" Grid.Row="1" Grid.Column="1"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         TextChanged="TBsquare_border_TextChanged" TextWrapping="Wrap" />
                <Button x:Name="Bsquare_color1" Grid.Row="2" Grid.Column="1" Width="64" Height="32"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Click="Bsquare_color1_Click" />
                <Button x:Name="Bsquare_color2" Grid.Row="3" Grid.Column="1" Width="64" Height="32"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Click="Bsquare_color2_Click" />
                <TextBox x:Name="TBmin_square_size" Grid.Row="4" Grid.Column="1"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         TextChanged="TBmin_square_size_TextChanged" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>
        <GroupBox x:Name="GBrecommended_square_size" Grid.Row="1" Grid.Column="1"
                       Header="{Binding L10NResourceMgr[GBrecommended_square_size],Mode=OneWay}"
                       RenderOptions.EdgeMode="Antialias">
            <Grid RowSpacing="12" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label x:Name="Lscreen_size" Grid.Row="0" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lscreen_size],Mode=OneWay}" Width="155"/>
                <TextBox x:Name="TBscreen_size" Grid.Row="0" Grid.Column="1"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" TextWrapping="Wrap" />
                <Label x:Name="Lscreen_resolution" Grid.Row="1" Grid.Column="0"
                       Content="{Binding L10NResourceMgr[Lscreen_resolution],Mode=OneWay}" />
                <TextBlock x:Name="TBLscreen_resolution" Grid.Row="1" Grid.Column="1"
                           Grid.ColumnSpan="2"
                           TextWrapping="Wrap"
                           Text="" />
                <Button x:Name="Bset_recommended_square" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Click="Click_Bset_recommended_square" HorizontalAlignment="Center"
                        Content="{Binding L10NResourceMgr[Bset_recommended_square],Mode=OneWay}" />
            </Grid>
        </GroupBox>
    </Grid>
    </Grid>
</Window>